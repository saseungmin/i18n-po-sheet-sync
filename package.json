{
  "name": "i18n-po-sheet-sync",
  "version": "1.1.0",
  "description": "Sync PO files to Google Spreadsheet",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "export": "ts-node example/export-to-po.ts",
    "upload": "ts-node example/upload-with-reset.ts",
    "build": "tsup src/index.ts --format cjs --dts",
    "publish-packages": "yarn run build && changeset version && changeset publish"
  },
  "author": {
    "email": "dbd02169@naver.com",
